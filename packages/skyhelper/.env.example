# TOKENS [REQUIRED]
TOKEN=
MONGO_CONNECTION=
PUBLIC_KEY=
CLIENT_ID=
API_ALLOWLIST_KEY=
SENTRY_DSN=

# Environment
NODE_ENV=
NODE_OPTIONS=--import ./scripts/register-loader.mjs
ENABLE_SWAGGER=

# Optional sharding overrides
SHARD_COUNT=
SHARD_IDS=

# BotLists [OPTIONAL]
TOPGG_TOKEN=
DBL_TOKEN=
GITHUB_ACCESS_TOKEN=
SENTRY_RELEASE=

# WEBHOOKS [OPTIONAL]
GUILD=
ERROR_LOGS=
READY_LOGS=
SUGGESTION=
CONTACT_US=
COMMANDS_USED=
BUG_REPORTS=